# Copy to .env and fill real values. NEVER commit .env.

# ── Telegram (from https://my.telegram.org/apps) ──────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=scroller_session

# MTProto proxy (t.me/proxy link). Empty/unset → direct. Set to "off" to force direct.
# TG_PROXY=

# The MCP server is a client-side process and uses its OWN session file, so it never
# contends with the poller for the same SQLite session. Default: <TELEGRAM_SESSION>_mcp.
# TELEGRAM_MCP_SESSION=scroller_session_mcp

# ── Live sending (CLI `send`, MCP `send_message`) ─────────────────────────────
# Sending acts as the real user account (not a bot) and is DENIED BY DEFAULT.
# List the chats you allow, or "*" to allow every chat. Reads need no allowlist.
SEND_ALLOWLIST=
# Hard ceiling on outbound messages per minute.
SEND_RATE_PER_MIN=20

# ── Storage ───────────────────────────────────────────────────────────────────
# Inside compose the host is the service name `db`. For a local run use 127.0.0.1.
DATABASE_URL=postgresql+psycopg://doomscroller:doomscroller@db:5432/doomscroller

# ── Ingest ────────────────────────────────────────────────────────────────────
# Comma-separated chats/channels/usernames/ids to subscribe to on first start.
SUBSCRIPTIONS=
POLL_INTERVAL=15
BATCH_SIZE=100
# Where Telethon keeps its session file (mounted volume in compose).
DATA_DIR=/data

# ── Scoring agent (`doomscroller score`) ──────────────────────────────────────
# Default backend: NanoGPT (OpenAI-compatible) serving DeepSeek. Both defaults live in
# the code, so an empty SCORER_BASE_URL/SCORER_MODEL below means "NanoGPT + DeepSeek".
#   NanoGPT      : https://nano-gpt.com/api/v1        (key from nano-gpt.com)
#   DeepSeek     : https://api.deepseek.com/v1        (direct, also OpenAI-compatible)
#   local Ollama : http://127.0.0.1:11434/v1          (compose: host.docker.internal)
SCORER_BASE_URL=https://nano-gpt.com/api/v1
# Either name works; NANOGPT_API_KEY is read as a fallback.
SCORER_API_KEY=
# NANOGPT_API_KEY=
# Pinned model id (see `doomscroller score --list-models`). Prices per 1M tokens:
#   deepseek-chat                    — original DeepSeek V3, $0.10/$0.43 (default)
#   deepseek/deepseek-v3.2           — V3.2, successor: $0.21/$0.31, 163k context
#   deepseek/deepseek-v4.1-flash     — $0.09/$0.25, 1M context, reasoning
#   deepseek/deepseek-v4-pro         — $0.70/$1.40, best quality
#   deepseek/deepseek-v3.2:thinking  — reasoning variant: slower, JSON can suffer
SCORER_MODEL=deepseek-chat
# Verify config, database and the paid endpoint before spending anything:
#   python -m doomscroller score --check
#   python -m doomscroller score --list-models deepseek
SCORER_TEMPERATURE=0
SCORER_TIMEOUT=600
SCORER_RETRIES=2
# auto | on | off — ask the backend for a JSON response format
# Read every Nth post (SCORER_SAMPLE_EVERY=5 → 1-из-5). Полное чтение: 1 или --sample-every 1.
# Выборка режет только первые прочтения; --force и пересчёты её не соблюдают.
SCORER_SAMPLE_EVERY=1
SCORER_JSON_MODE=auto
# Pin the model's thinking budget: none | low | high | max (model-specific).
# A reasoning model can burn 4-7k output tokens per post; `none` restores the plain regime.
# SCORER_REASONING_EFFORT="" 
# Where the rubric modules live (they are markdown, editable without touching code).
# SCORER_RUBRIC_DIR=/app/scoring
# Posts shorter than this are archived but not scored (recorded as `skipped`).
SCORER_MIN_CHARS=120
SCORER_MAX_CHARS=12000
# Per-tick budget and scheduler interval (seconds).
SCORER_MAX_POSTS_PER_RUN=20
SCORER_INTERVAL=900
SCORER_MAX_ATTEMPTS=3
# Rebuild the channel memory (profile + trajectory summary) every N posts; 0 = never.
SCORER_SUMMARY_EVERY=5
# EWMA window of the channel trend.
SCORER_WINDOW=5
# Optional: force one genre for every post (e.g. `трактат`); empty = the model decides.
SCORER_GENRE=

# ── Where each variable is used ──────────────────────────────────────────────
#   poller (`doomscroller`) : TELEGRAM_*, DATA_DIR, DATABASE_URL, SUBSCRIPTIONS, ...
#   scorer (its own container): DATABASE_URL + SCORER_*. It does NOT receive Telegram
#     credentials, the session, or SEND_ALLOWLIST — compose passes only SCORER_* to it.
#   MCP (outside compose)   : DATABASE_URL; add TELEGRAM_* + DATA_DIR only for the live
#     tools (list_chats / send_message), and SEND_ALLOWLIST to send at all.

# ── Compose ───────────────────────────────────────────────────────────────────
POSTGRES_USER=doomscroller
POSTGRES_PASSWORD=doomscroller
POSTGRES_DB=doomscroller
POSTGRES_PORT=5434
ADMINER_PORT=8082

# ── Optional: LLM event detection (pip install '.[detector]') ─────────────────
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3
# DETECTOR_PURPOSE=Observe chats and detect when a new job task is assigned.
# DETECTOR_EVENTS=New job task assigned|Existing task updated|Task cancelled
